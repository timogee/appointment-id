# Local dev database (docker compose up -d)
DATABASE_URL=postgres://barberkuy:barberkuy@localhost:5433/barberkuy

# Single admin password. Real auth replaces this — see docs/PRODUCTION-PATH.md.
ADMIN_PASSWORD=rahasia

# --- Provider selection. This is the ONLY place implementations are chosen.
#     Read by src/providers/registry.ts.
NOTIFIER=console                # console | whatsapp_cloud
PAYMENT_PROVIDER=manual         # manual | midtrans (not built yet)
CHAT_MODEL=auto                 # auto | anthropic | scripted
INBOUND_ADAPTER=cli             # cli | whatsapp_webhook

# Required only when CHAT_MODEL resolves to anthropic. Absent => scripted.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- WhatsApp Cloud API. Required only when NOTIFIER=whatsapp_cloud and/or
#     INBOUND_ADAPTER=whatsapp_webhook. See docs/TRANSITION.md §7.
WHATSAPP_TOKEN=                 # permanent access token, from the app dashboard
WHATSAPP_PHONE_NUMBER_ID=       # from the app dashboard
WHATSAPP_VERIFY_TOKEN=          # a string YOU invent (openssl rand -hex 32), pasted into Meta's webhook form
WHATSAPP_APP_SECRET=            # App settings -> Basic -> App secret; authenticates every inbound POST
