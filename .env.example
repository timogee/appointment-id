# Local dev database (docker compose up -d)
DATABASE_URL=postgres://barberkuy:barberkuy@localhost:5433/barberkuy

# Single admin password. Real auth replaces this — see docs/PRODUCTION-PATH.md.
ADMIN_PASSWORD=rahasia

# --- Provider selection. This is the ONLY place implementations are chosen.
#     Read by src/providers/registry.ts.
NOTIFIER=console                # console | whatsapp_cloud (not built yet)
PAYMENT_PROVIDER=manual         # manual | midtrans (not built yet)
CHAT_MODEL=auto                 # auto | anthropic | scripted
INBOUND_ADAPTER=cli             # cli | whatsapp_webhook (not built yet)

# Required only when CHAT_MODEL resolves to anthropic. Absent => scripted.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
